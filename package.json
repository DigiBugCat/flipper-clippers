{
  "name": "clip-ranker",
  "version": "1.0.0",
  "description": "Tinder-like pairwise comparison system for ranking Twitch clips",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute clip-ranker-db --file=src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute clip-ranker-db --local --file=src/db/schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "hono": "^4.6.14"
  }
}
